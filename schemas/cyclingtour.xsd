<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
		   targetNamespace="http://bike4you.fr/cyclingtour#"
           xmlns:ct="http://bike4you.fr/cyclingtour#"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">



		   <!--
KEYS + KEYREFS (identity constraints)

- Keys (xs:key) define unique IDs in a database 
  (e.g. each CLIENT has unique @ID_client).
- Keyrefs (xs:keyref) make sure references point 
  to those IDs (e.g. BOOKING/CLIENT_REF must 
  match a CLIENT/@ID_client).

WHY ARE THEY HERE (as siblings of the root element)?
- By XSD rules, keys/keyrefs must be declared at 
  the element that covers their scope. 
- Root <cyclingtours> is the scope, so keys/keyrefs 
  are siblings of its complexType.

WHY CHANGE SELECTORS?
- Instead of selecting BOOKING and filtering with 
  [ct:ACTIVITY_REF], we select REF elements directly 
  and use "." as field.
- This is simpler, avoids red editor lines, and is 
  fully valid.

EXAMPLE:
<xs:keyref name="BookingClientRef" refer="ct:ClientById">
  <xs:selector xpath="ct:BOOKINGS_Database/ct:BOOKING/ct:CLIENT_REF"/>
  <xs:field xpath="."/>
</xs:keyref>

This means: every <CLIENT_REF> inside a BOOKING 
must match some CLIENT/@ID_client.
-->

	<!-- =========================
		 ROOT element
		 ========================= -->
	<xs:element name="cyclingtours">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BIKES_Database" type="ct:BikesType"/>
				<xs:element name="ACTIVITIES_Database" type="ct:ActivitiesType"/>
				<xs:element name="EVENTS_Database" type="ct:EventsType"/>
				<xs:element name="CLIENTS_Database" type="ct:ClientsType"/>
				<xs:element name="BOOKINGS_Database" type="ct:BookingsType"/>
				<xs:element name="PATHS_Database" type="ct:PathsType"/>
				<xs:element name="DESTINATIONS_Database" type="ct:DestinationsType"/>
				<xs:element name="TOURPACKAGES_Database" type="ct:TourPackagesType"/>
				<xs:element name="GUIDES_Database" type="ct:GuidesType"/>
			</xs:sequence>
		</xs:complexType>

		    <!-- ===== Referential Integrity (keys + keyrefs) ===== -->
        <!-- identities -->
        <xs:key name="ClientById">
            <xs:selector xpath="ct:CLIENTS_Database/ct:CLIENT" />
            <xs:field xpath="@ID_client" />
        </xs:key>
        <xs:key name="ActivityById">
            <xs:selector xpath="ct:ACTIVITIES_Database/ct:ACTIVITY" />
            <xs:field xpath="@ID_Activity" />
        </xs:key>
        <xs:key name="PackageById">
            <xs:selector xpath="ct:TOURPACKAGES_Database/ct:TOURPACKAGE" />
            <xs:field xpath="@ID_TourPackage" />
        </xs:key>
        <xs:key name="GuideById">
            <xs:selector xpath="ct:GUIDES_Database/ct:GUIDE" />
            <xs:field xpath="@ID_Guide" />
        </xs:key>
        <!-- references from bookings -->
        <xs:keyref name="BookingClientRef"
                   refer="ct:ClientById">
            <xs:selector xpath="ct:BOOKINGS_Database/ct:BOOKING/ct:CLIENT_REF" />
            <xs:field xpath="." />
        </xs:keyref>
        <xs:keyref name="BookingActivityRef"
                   refer="ct:ActivityById">
            <xs:selector xpath="ct:BOOKINGS_Database/ct:BOOKING/ct:ACTIVITY_REF" />
            <xs:field xpath="." />
        </xs:keyref>
        <xs:keyref name="BookingPackageRef"
                   refer="ct:PackageById">
            <xs:selector xpath="ct:BOOKINGS_Database/ct:BOOKING/ct:PACKAGE_REF" />
            <xs:field xpath="." />
        </xs:keyref>
        <xs:keyref name="BookingGuideRef"
                   refer="ct:GuideById">
            <xs:selector xpath="ct:BOOKINGS_Database/ct:BOOKING/ct:GUIDE_REF" />
            <xs:field xpath="." />
        </xs:keyref>
	</xs:element>
	

	<!-- =========================
		 BIKES_Database
		 ========================= -->
	<xs:complexType name="BikesType">
		<xs:sequence>
			<xs:element name="BIKE" maxOccurs="unbounded" type="ct:BikeType"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="BikeType">
	
		<xs:sequence>
			<xs:element name="BIKE_BRAND" type="xs:string"/>
			<xs:element name='BIKE_CATEGORY' type="ct:BikeCategoryType"/>
			<xs:element name='BIKE_PRICE' type='ct:PriceType'/>
			<xs:element name='HEIGHT' type='xs:string'/>
			<xs:element name='RIDER_LEVEL' type='ct:RiderLevelType'/>
			<xs:element name='TRAVERSABLE_BIKE_ROAD' type="ct:RoadType"/>
			<xs:element name='TOTAL_BIKES' type='xs:integer'/>
			<xs:element name='AVAILABLE_BIKES' type='xs:integer'/>
		</xs:sequence>

		<!-- MAIN Bike attributes -->
		<xs:attribute name="ID_Bike" type="xs:ID" use="required"/>
		
	</xs:complexType>	

	<!-- simpletypes for the complexeType BikeType above -->
	<xs:simpleType name="BikeCategoryType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Mountain"/>
			<xs:enumeration value="Road"/>
			<xs:enumeration value="Gravel"/>
			<xs:enumeration value="City"/>
			<xs:enumeration value="E-bike"/>
			<xs:enumeration value="Kids"/>
		</xs:restriction>
	</xs:simpleType>					
	<xs:simpleType name="RiderLevelType">
	  <xs:restriction base="xs:string">
		<xs:enumeration value="Beginner"/>
		<xs:enumeration value="Intermediate"/>
		<xs:enumeration value="Advanced"/>
	  </xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="RoadType">		
		<xs:list itemType="ct:GroundType"/> 
	</xs:simpleType>
	<xs:simpleType name='GroundType'>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Asphalt"/>
			<xs:enumeration value="Mud"/>
			<xs:enumeration value="Gravel"/>
			<xs:enumeration value="LargeStone"/>
			<xs:enumeration value="Dirt"/>
		</xs:restriction>
	</xs:simpleType>
	

	<!-- =========================
		 ACTIVITIES_Database
		 ========================= -->
	<xs:complexType name="ActivitiesType">
		<xs:sequence>
			<xs:element name="ACTIVITY" maxOccurs="unbounded" type="ct:ActivityType"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="ActivityType">

		<xs:sequence>
              <xs:element name="ACTIVITY_NAME" type="xs:string"/>
              <xs:element name="ACTIVITY_TYPE" type="ct:Activity_typeType"/>
			  <xs:element name="PRICE" type='ct:PriceType' minOccurs="1"/>
              <xs:element name="FREQUENCY" type="ct:FrequencyType"/>
              <xs:element name="DISTANCE_KM" type="xs:integer" minOccurs="1"/>
              <xs:element name="DAYS_DURATION" type="xs:integer" minOccurs="1"/>
              <xs:element name="HOURS_DURATION" type="xs:integer"/>
              <xs:element name="LOCATION_CITY" type="xs:string" minOccurs="1"/>
              <xs:element name="LOCATION_COUNTRY" type="xs:string"/>
			  <xs:element name="REVIEWS_RATE_AVG" type="ct:Reviews_rate_avgType"/>
			  <xs:element name='ROAD_SURFACE' type="ct:RoadType"/>
         </xs:sequence>
		 
		 <!-- Guided attribute -->
		 <xs:attribute name="guided" use="optional">
		    <xs:simpleType>
			  <xs:restriction base="xs:string">
			    <xs:enumeration value="fully"/>
				<xs:enumeration value="partially"/>
			    <xs:enumeration value="none"/>
		      </xs:restriction>
		    </xs:simpleType>
		 </xs:attribute>
		  
		 <!-- MAIN Activity attributes -->
		 <xs:attribute name="ID_Activity" type="xs:ID" use="required"/>

	</xs:complexType>

	<!-- simpletypes for the complexeType ActivityType above -->
	<xs:simpleType name="Activity_typeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Sportive"/>
			<xs:enumeration value="Competitive"/>
			<xs:enumeration value="Familiale"/>
			<xs:enumeration value="Aventure"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Reviews_rate_avgType">
		<xs:restriction base="xs:string">
			<xs:pattern value="(10|[0-9])/10"/>
		</xs:restriction>
	</xs:simpleType>
	

	<!-- =========================
		 EVENTS_Database
		 ========================= -->
	<xs:complexType name="EventsType">
	  <xs:sequence>
		<xs:element name="EVENT" type="ct:EventType" maxOccurs="unbounded"/>
	  </xs:sequence>
	</xs:complexType>

	<!-- One event -->
	<xs:complexType name="EventType">
	  <xs:sequence>
		<xs:element name="EVENT_NAME" type="xs:string"/>
		<xs:element name="EVENT_CATEGORY" type="ct:EventCategoryType"/>
		<xs:element name="DATE" type="ct:EventDateBlockType"/>
		<xs:element name="LOCATION" type="ct:EventLocationType"/>
		<xs:element name="ORGANIZER" type="xs:string" minOccurs="0"/>
		<xs:element name="CAPACITY" type="xs:nonNegativeInteger" minOccurs="0"/>
		<!-- Price is optional; reuse your PriceType -->
		<xs:element name="TICKET_PRICE" type="ct:PriceType" minOccurs="0"/>
		<!-- Optionally relate events to one or more activities (by ID value) -->
		<xs:element name="RELATED_ACTIVITY_REF" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
	  </xs:sequence>
	  <xs:attribute name="ID_Event" type="xs:ID" use="required"/>
	</xs:complexType>

	<!-- Event category vocabulary (different from activities) -->
	<xs:simpleType name="EventCategoryType">
	  <xs:restriction base="xs:string">
		<xs:enumeration value="Race"/>
		<xs:enumeration value="Festival"/>
		<xs:enumeration value="Workshop"/>
		<xs:enumeration value="Expo"/>
		<xs:enumeration value="Charity"/>
		<xs:enumeration value="Community Ride"/>
	  </xs:restriction>
	</xs:simpleType>

	<!-- Where the event takes place -->
	<xs:complexType name="EventLocationType">
	  <xs:sequence>
		<xs:element name="CITY" type="xs:string"/>
		<xs:element name="COUNTRY" type="xs:string"/>
		<xs:element name="POSTALCODE" type="xs:string" minOccurs="0"/>
		<xs:element name="ADDRESS" type="xs:string" minOccurs="0"/>
	  </xs:sequence>
	</xs:complexType>

	<!-- Event dates (end is optional; recurrence optional) -->
	<xs:complexType name="EventDateBlockType">
	  <xs:sequence>
		<xs:element name="START_DATE" type="xs:date"/>
		<xs:element name="END_DATE" type="xs:date" minOccurs="0"/>
		<xs:element name="FREQUENCY" type="ct:FrequencyType" minOccurs="0"/>
	  </xs:sequence>
	</xs:complexType>

	<!-- Simple recurrence vocabulary -->
	<xs:simpleType name="FrequencyType">
	  <xs:restriction base="xs:string">
		<xs:enumeration value="none"/>
		<xs:enumeration value="weekly"/>
		<xs:enumeration value="monthly"/>
		<xs:enumeration value="annual"/>
	  </xs:restriction>
	</xs:simpleType>	


	<!-- =========================
		 CLIENTS_Database
		 ========================= -->
	<xs:complexType name="ClientsType">
		<xs:sequence>
			<xs:element name="CLIENT" maxOccurs="unbounded" type="ct:ClientInfo"/>
		</xs:sequence>
	</xs:complexType>
	
	<!-- Single client -->
	<xs:complexType name="ClientInfo">
	
		<xs:sequence>		
			<xs:element name="NAME" type="xs:string" minOccurs="1"/>
			<xs:element name="ADDRESS" type="xs:string"/>
			<xs:element name="POSTALCODE" minOccurs="1" type="ct:PostalcodeType"/>
			<xs:element name="CITY" type="xs:string"/>
			<xs:element name="COUNTRY" type="xs:string"/>
			<xs:element name="BIRTHDATE" type="xs:date"/>
			<xs:element name="PHONE" minOccurs="1" type="ct:PhoneType"/>
			<xs:element name="MAIL" minOccurs="1" type="ct:MailType"/>
			<xs:element name="CLIENT_TYPE" type="ct:ClientType"/>	
			<xs:element name="PREMIUM_MEMBER" minOccurs="0" type="xs:boolean"/>	<!-- optional premium member element -->
		</xs:sequence>
		
		<xs:attribute name="ID_client" type="xs:ID" use="required"/>
		
	</xs:complexType>

	<!-- simpletypes for the complexeType ClientType above -->
	<xs:simpleType name="PostalcodeType">
		<xs:restriction base="xs:string">
			<xs:pattern value="\d{4,10}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PhoneType">
		<xs:restriction base="xs:string">
			<xs:minLength value="6"/>
			<xs:maxLength value="15"/>
			<xs:pattern value="\+?\d+"/>    <!-- verifier si cest bon -->
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MailType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[^@\s]+@[^@\s]+\.[^@\s]+"/>	<!-- verifier si cest bon -->
		</xs:restriction>
	</xs:simpleType>	
	<xs:simpleType name="ClientType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="new"/>
			<xs:enumeration value="regular"/>
			<xs:enumeration value="occasional"/>
		</xs:restriction>
	</xs:simpleType>
		
	<!-- =========================
		 BOOKINGS_Database
		 ========================= -->
	<xs:complexType name="BookingsType">
		<xs:sequence>
			<xs:element name="BOOKING" maxOccurs="unbounded" type="ct:BookingType"/>
		</xs:sequence>
	</xs:complexType>

	<!-- Single booking -->
	<xs:complexType name="BookingType">

		<xs:sequence>
			<xs:element name="CLIENT_REF" type="xs:string"/>
			<xs:choice>
				<xs:element name="ACTIVITY_REF" type="xs:string"/>
				<xs:element name="PACKAGE_REF" type="xs:string"/>
			</xs:choice>
			<xs:element name="LOCATION_CITY" type="xs:string"/>
			<xs:element name="LOCATION_COUNTRY" type="xs:string"/>
			<xs:element name="TOTAL_PRICE" type="ct:PriceType"/>
			<xs:element name="BOOKING_DATE" type="xs:date"/>
			<xs:element name="START_DATE" type="xs:date"/>
			<xs:element name="END_DATE" type="xs:date"/>
			<xs:element name="GUIDE_REF" type="xs:string" minOccurs="0"/>
			<xs:element name="PARTICIPANTS" type="xs:positiveInteger" minOccurs="0"/>
			<xs:element name="STATUS" type="ct:BookingStatusType" minOccurs="0" default="pending"/>
		</xs:sequence>
		
		<!-- Booking attributes -->
		<xs:attribute name="ID_Booking" type="xs:ID" use="required"/>
		<xs:attribute name="With_Guide" type="xs:boolean" use="required"/>
	</xs:complexType>

	<!-- simpletypes for the complexType BookingType above -->

	<!-- Price with currency -->
	<xs:complexType name="PriceType">
		<xs:simpleContent>
			<xs:extension base="xs:decimal">
				<xs:attribute name="CURRENCY" type="ct:CurrencyCodeType" use="optional" default="EUR"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<!-- Currency -->
	<xs:simpleType name="CurrencyCodeType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Z]{3}"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Booking status -->
	<xs:simpleType name="BookingStatusType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="pending"/>
			<xs:enumeration value="confirmed"/>
			<xs:enumeration value="cancelled"/>
		</xs:restriction>
	</xs:simpleType>


	<!-- =========================
		 PATHS_Database
		 ========================= -->
	<xs:complexType name="PathsType">
		<xs:sequence>
			<xs:element name="PATH" maxOccurs="unbounded" type="ct:PathType"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name='PathType'>
		<xs:sequence>
			<xs:element name='ENVIRONMENT' type="ct:EnvironmentType"/>
			<xs:element name='PATH_ROAD' type="ct:RoadType"/>
			<xs:element name='DISTANCE_IN_KM' type="ct:DistanceType"/> <!-- Distance in kilometers -->
			<xs:element name='ALTITUDEDIFFERENCE_IN_METERS' type="ct:DistanceType"/> <!-- Altitude in meters -->
			<xs:element name='ESTIMATEDTIME_IN_MINUTES' type="ct:TimeType"/>
			<xs:element name='LEVEL' type="ct:LevelType"/>
		</xs:sequence>
		<xs:attribute name='ID_Path' type="xs:ID" use="required"/>
	</xs:complexType>
	
	<xs:simpleType name='EnvironmentType'>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Countryside"/>
			<xs:enumeration value="Mountain"/>
			<xs:enumeration value="Littoral"/>
			<xs:enumeration value="City"/>
		</xs:restriction>
	</xs:simpleType>
	
	<xs:simpleType name="DistanceType">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="5"/>
		</xs:restriction>
	</xs:simpleType>
	
	<xs:simpleType name="TimeType">
	<!-- Time in minutes -->
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="15"/>
		</xs:restriction>
	</xs:simpleType>
	
	<xs:simpleType name='LevelType'>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Beginner"/>
			<xs:enumeration value="Intermediate"/>
			<xs:enumeration value="Expert"/>
		</xs:restriction>
	</xs:simpleType>


	<!-- =========================
		 DESTINATIONS_Database
		 ========================= -->
	<xs:complexType name="DestinationsType">
		<xs:sequence>
			<xs:element name="DESTINATION" maxOccurs="unbounded" type="ct:DestinationType"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name='DestinationType'>
		<xs:sequence>
			<xs:element name='COUNTRY' type="ct:CountryType"/>
			<xs:choice>
				<xs:element name='DEPARTCITY' type="xs:string"/>
				<xs:element name='DEPARTPOSTALCODE' type="xs:string"/>
				<xs:element name='DEPARTADDRESS' type="xs:string"/>
			</xs:choice>
			<xs:element name='CITIESCROSSED' type='ct:CrossedType'/>
			<xs:choice>
				<xs:element name='ARRIVALCITY' type="xs:string"/>
				<xs:element name='ARRIVALPOSTALCODE' type="xs:integer"/>
				<xs:element name='ARRIVALADDRESS' type="xs:string"/>
			</xs:choice>
		</xs:sequence>
		<xs:attribute name='ID_Destination' type="xs:ID" use="required"/>
	</xs:complexType>
	
	<xs:simpleType name='CountryType'>
		<xs:restriction base="xs:string">
			<xs:enumeration value="France"/>
			<xs:enumeration value="Spain"/>
			<xs:enumeration value="Italy"/>
			<xs:enumeration value="Germany"/>
			<xs:enumeration value="Swiss"/>
		</xs:restriction>
	</xs:simpleType>
	
<!-- verifier si on peut mettre maxoccurs dans xs:choice -->	
	
	<xs:complexType name='CrossedType'>
		<xs:sequence>
			<xs:choice>
				<xs:element name="CITY" type="xs:string" maxOccurs="unbounded"/>
				<xs:element name="POSTALCODE" type="xs:string" maxOccurs="unbounded"/>
			</xs:choice>
        </xs:sequence>
	</xs:complexType>


	<!-- =========================
		 TOURPACKAGES_Database
		 ========================= -->
	<xs:complexType name="TourPackagesType">
		<xs:sequence>
			<xs:element name="TOURPACKAGE" maxOccurs="unbounded" type="ct:TourPackageType"/>
		</xs:sequence>
	</xs:complexType>

	<!-- One tour package -->
	<xs:complexType name="TourPackageType">
		<xs:sequence>
			<!-- package_name is required -->
			<xs:element name="PACKAGE_NAME" type="xs:string"/>
			<!-- difficulty (beginner, easy, moderate, difficult, expert) -->
			<xs:element name="DIFFICULTY" type="ct:DifficultyType"/>
			<!-- description (optional) -->
			<xs:element name="DESCRIPTION" type="ct:DescriptionType" minOccurs="0"/>
			<!-- date of the tour -->
			<xs:element name="DATE" type="ct:DateBlockType"/>
			<!-- group size (integer >= 1) -->
			<xs:element name="GROUP_SIZE">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:minInclusive value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<!-- equipment block -->
			<xs:element name="EQUIPMENT" type="ct:EquipmentType"/>
			<!-- package price -->
			<xs:element name="PACKAGE_PRICE" type="ct:PriceType"/>
		</xs:sequence>
		<xs:attribute name='ID_TourPackage' type="xs:ID" use="required"/>
	</xs:complexType>
	
	<!-- difficulty options -->
	<xs:simpleType name="DifficultyType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="beginner"/>
			<xs:enumeration value="easy"/>
			<xs:enumeration value="moderate"/>
			<xs:enumeration value="difficult"/>
			<xs:enumeration value="expert"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- description part -->
	<xs:complexType name="DescriptionType">
		<xs:sequence>
			<!-- short text about the package -->
			<xs:element name="SHORT_DESCRIPTION" type="xs:string" minOccurs="1"/>
			<!-- activity and environment -->
			<xs:element name="ACTIVITY" type="xs:string" minOccurs="0"/>
			<xs:element name="ENVIRONMENT" type="xs:string" minOccurs="0"/>
			<!-- accommodation is optional -->
			<xs:element name="ACCOMMODATION" type="ct:AccommodationType" minOccurs="0"/>
			<!-- food info is optional and can repeat -->
			<xs:element name="FOOD_INFO" type="ct:FoodOptionType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<!-- accommodation block -->
	<xs:complexType name="AccommodationType">
		<xs:sequence>
			<xs:element name="NAME" type="xs:string"/>
			<xs:element name="ADDRESS" type="xs:string"/>
			<!-- rating on 5 -->
			<xs:element name="RATING" type="ct:StarRatingType"/>
		</xs:sequence>
	</xs:complexType>
	<!-- stars -->
	<xs:simpleType name="StarRatingType">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="5"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- food options -->
	<xs:simpleType name="FoodOptionType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="breakfast only"/>
			<xs:enumeration value="all meal available"/>
			<xs:enumeration value="self catering"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- date block -->
	<xs:complexType name="DateBlockType">
		<xs:sequence>
			<!-- start_date_hour is required (YYYY-MM-DD) -->
			<xs:element name="START_DATE_HOUR" type="xs:date"/>
			<!-- end_date is optional, can be date or empty -->
			<xs:element name="END_DATE" minOccurs="0">
				<xs:simpleType>
					<xs:union memberTypes="xs:date ct:EmptyString"/>	<!-- c'est repetitif avec minOccurs=0 ==> should we remove the minOccur??? -->
				</xs:simpleType>
			</xs:element>
			<!-- duration required in DD-HH format -->
			<xs:element name="DURATION" type="ct:DurationDDHH"/>
		</xs:sequence>
	</xs:complexType>
	<!-- allow empty string -->
	<xs:simpleType name="EmptyString">
		<xs:restriction base="xs:string">
			<xs:length value="0"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- duration pattern -->
	<xs:simpleType name="DurationDDHH">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{2}-[0-9]{2}"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- equipment block -->
	<xs:complexType name="EquipmentType">
		<xs:sequence>
			<!-- requiredBikeType is optional -->
			<xs:element name="REQUIREDBIKETYPE" type="xs:string" minOccurs="0"/>
			<!-- canRentBike yes/no is required -->
